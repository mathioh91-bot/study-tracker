<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        xmlns:converters="clr-namespace:WpfApp1.Converters"
        xmlns:behaviors="clr-namespace:WpfApp1.Behaviors"
        mc:Ignorable="d"
        Title="Study Planner" Height="900" Width="1400" 
        Background="{StaticResource BackgroundColor}"
        FontFamily="{StaticResource DefaultFont}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:EnumToStringConverter x:Key="EnumToStringConverter" />
        <converters:PriorityToColorConverter x:Key="PriorityToColorConverter" />
        <converters:StatusToColorConverter x:Key="StatusToColorConverter" />

        <!-- DataGrid Row Style -->
        <Style x:Key="DataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
            <Setter Property="FontFamily" Value="{StaticResource DefaultFont}" />
            <Setter Property="FontSize" Value="12" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F9F9F9" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E3F2FD" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.2*" MinWidth="200" />
            <ColumnDefinition Width="0.8*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Grid Grid.Column="0" Background="{StaticResource PrimaryColor}" VerticalAlignment="Stretch">
            <StackPanel Margin="20" VerticalAlignment="Top">
                <!-- Logo -->
                <TextBlock Text="📚 Study Planner" FontSize="24" Foreground="White" FontWeight="Bold" Margin="0,0,0,30" />

                <!-- Navigation Buttons -->
                <Button Content="➕ Add Task" 
                        Command="{Binding AddTaskCommand}"
                        Style="{StaticResource ModernButton}"
                        Background="{StaticResource AccentColor}"
                        Margin="0,0,0,12"
                        Padding="12,12"
                        FontWeight="Bold" />

                <Button Content="🔄 Clear Filters" 
                        Command="{Binding ClearFiltersCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Background="White"
                        Foreground="{StaticResource TextPrimary}"
                        Margin="0,0,0,12"
                        Padding="12,12" />

                <!-- Statistics Section -->
                <TextBlock Text="Statistics" FontSize="16" Foreground="White" FontWeight="Bold" Margin="0,30,0,16" />

                <!-- Stat Card: Total Tasks -->
                <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,10" Effect="{StaticResource CardShadowEffect}">
                    <StackPanel>
                        <TextBlock Text="Total Tasks" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                        <TextBlock Text="{Binding TotalTasks}" FontSize="28" Foreground="{StaticResource PrimaryColor}" FontWeight="Bold" />
                    </StackPanel>
                </Border>

                <!-- Stat Card: Completed -->
                <Border Background="#E8F5E9" CornerRadius="8" Padding="12" Margin="0,0,0,10" Effect="{StaticResource CardShadowEffect}">
                    <StackPanel>
                        <TextBlock Text="✓ Completed" FontSize="12" Foreground="#4CAF50" FontWeight="Bold" />
                        <TextBlock Text="{Binding CompletedTasks}" FontSize="24" Foreground="#2E7D32" FontWeight="Bold" />
                    </StackPanel>
                </Border>

                <!-- Stat Card: Pending -->
                <Border Background="#FFF3E0" CornerRadius="8" Padding="12" Margin="0,0,0,10" Effect="{StaticResource CardShadowEffect}">
                    <StackPanel>
                        <TextBlock Text="⏳ Pending" FontSize="12" Foreground="#FF9800" FontWeight="Bold" />
                        <TextBlock Text="{Binding PendingTasks}" FontSize="24" Foreground="#F57C00" FontWeight="Bold" />
                    </StackPanel>
                </Border>

                <!-- Stat Card: In Progress -->
                <Border Background="#E3F2FD" CornerRadius="8" Padding="12" Margin="0,0,0,10" Effect="{StaticResource CardShadowEffect}">
                    <StackPanel>
                        <TextBlock Text="⚡ In Progress" FontSize="12" Foreground="#2196F3" FontWeight="Bold" />
                        <TextBlock Text="{Binding InProgressTasks}" FontSize="24" Foreground="#1565C0" FontWeight="Bold" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Main Content Area -->
        <Grid Grid.Column="1" Margin="{StaticResource ContentPadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0" Text="Tasks Management" FontSize="28" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" Margin="0,0,0,20" />

            <!-- Search and Filter Section -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search Box -->
                <TextBox Grid.Column="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBox}"
                         behaviors:TextBoxBehavior.Placeholder="Search tasks by title or subject..."
                         Margin="0,0,12,0" />

                <!-- Clear Search Button -->
                <Button Grid.Column="1"
                        Content="🔍 Clear"
                        Command="{Binding ClearSearchCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,12,0"
                        Padding="10,8" />

                <!-- Status Filter -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,12,0">
                    <Button Content="All Status"
                            Command="{Binding FilterStatusCommand}"
                            CommandParameter="{x:Null}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="10,8"
                            Margin="0,0,6,0" />
                    <Button Content="Pending"
                            Command="{Binding FilterStatusCommand}"
                            CommandParameter="Pending"
                            Style="{StaticResource SecondaryButton}"
                            Padding="10,8"
                            Margin="0,0,6,0" />
                    <Button Content="In Progress"
                            Command="{Binding FilterStatusCommand}"
                            CommandParameter="InProgress"
                            Style="{StaticResource SecondaryButton}"
                            Padding="10,8"
                            Margin="0,0,6,0" />
                    <Button Content="Completed"
                            Command="{Binding FilterStatusCommand}"
                            CommandParameter="Completed"
                            Style="{StaticResource SecondaryButton}"
                            Padding="10,8" />
                </StackPanel>

                <!-- Priority Filter -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,12,0">
                    <Button Content="All Priority"
                            Command="{Binding FilterPriorityCommand}"
                            CommandParameter="{x:Null}"
                            Style="{StaticResource SecondaryButton}"
                            Padding="10,8"
                            Margin="0,0,6,0" />
                    <Button Content="Low"
                            Command="{Binding FilterPriorityCommand}"
                            CommandParameter="Low"
                            Style="{StaticResource SecondaryButton}"
                            Padding="10,8"
                            Margin="0,0,6,0" />
                    <Button Content="Medium"
                            Command="{Binding FilterPriorityCommand}"
                            CommandParameter="Medium"
                            Style="{StaticResource SecondaryButton}"
                            Padding="10,8"
                            Margin="0,0,6,0" />
                    <Button Content="High"
                            Command="{Binding FilterPriorityCommand}"
                            CommandParameter="High"
                            Style="{StaticResource SecondaryButton}"
                            Padding="10,8" />
                </StackPanel>

                <!-- Edit Button -->
                <Button Grid.Column="4"
                        Content="✏️ Edit"
                        Command="{Binding EditTaskCommand}"
                        Style="{StaticResource ModernButton}"
                        Padding="10,8" />
            </Grid>

            <!-- Task List -->
            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding FilteredTasks}"
                      SelectedItem="{Binding SelectedTask}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      RowHeight="60"
                      Background="{StaticResource CardBackground}"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      RowStyle="{StaticResource DataGridRowStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="200" />
                    <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="120" />
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                    <DataGridTextColumn Header="Deadline" Binding="{Binding Deadline, StringFormat=yyyy-MM-dd}" Width="100" />
                    <DataGridTextColumn Header="Priority" Binding="{Binding Priority, Converter={StaticResource EnumToStringConverter}}" Width="80" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status, Converter={StaticResource EnumToStringConverter}}" Width="100" />
                    <DataGridTemplateColumn Header="Delete" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="🗑️ Delete"
                                        Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="6,4"
                                        FontSize="11" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

        </Grid>

        <!-- Task Dialog (Modal) -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2"
              Background="#000000"
              Opacity="0.5"
              Visibility="{Binding IsTaskDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
              ZIndex="100" />

        <Grid Grid.Column="0" Grid.ColumnSpan="2"
              Visibility="{Binding IsTaskDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
              ZIndex="101"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
            <Border Background="{StaticResource CardBackground}"
                    CornerRadius="12"
                    Padding="30"
                    Effect="{StaticResource CardShadowEffect}"
                    Width="500"
                    MaxHeight="700">
                <StackPanel>
                    <!-- Dialog Title -->
                    <TextBlock Text="{Binding DialogTitle}" FontSize="20" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" Margin="0,0,0,20" />

                    <!-- Task Form -->
                    <ScrollViewer MaxHeight="500" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20">
                        <StackPanel>
                            <!-- Title Field -->
                            <TextBlock Text="Title *" FontSize="12" Foreground="{StaticResource TextSecondary}" FontWeight="Bold" Margin="0,0,0,6" />
                            <TextBox Text="{Binding CurrentEditingTask.Title, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}"
                                     Margin="0,0,0,16" />

                            <!-- Subject Field -->
                            <TextBlock Text="Subject" FontSize="12" Foreground="{StaticResource TextSecondary}" FontWeight="Bold" Margin="0,0,0,6" />
                            <TextBox Text="{Binding CurrentEditingTask.Subject, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}"
                                     Margin="0,0,0,16" />

                            <!-- Description Field -->
                            <TextBlock Text="Description" FontSize="12" Foreground="{StaticResource TextSecondary}" FontWeight="Bold" Margin="0,0,0,6" />
                            <TextBox Text="{Binding CurrentEditingTask.Description, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}"
                                     Height="80"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,0,16" />

                            <!-- Deadline Field -->
                            <TextBlock Text="Deadline" FontSize="12" Foreground="{StaticResource TextSecondary}" FontWeight="Bold" Margin="0,0,0,6" />
                            <DatePicker SelectedDate="{Binding CurrentEditingTask.Deadline}"
                                        Margin="0,0,0,16" />

                            <!-- Priority Field -->
                            <TextBlock Text="Priority" FontSize="12" Foreground="{StaticResource TextSecondary}" FontWeight="Bold" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding PriorityValues}"
                                      SelectedItem="{Binding CurrentEditingTask.Priority}"
                                      Style="{StaticResource ModernComboBox}"
                                      Margin="0,0,0,16" />

                            <!-- Status Field -->
                            <TextBlock Text="Status" FontSize="12" Foreground="{StaticResource TextSecondary}" FontWeight="Bold" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding StatusValues}"
                                      SelectedItem="{Binding CurrentEditingTask.Status}"
                                      Style="{StaticResource ModernComboBox}"
                                      Margin="0,0,0,20" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Dialog Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="Cancel"
                                Command="{Binding CancelTaskCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,12,0"
                                Padding="12,10" />

                        <Button Grid.Column="1"
                                Content="Save Task"
                                Command="{Binding SaveTaskCommand}"
                                Style="{StaticResource ModernButton}"
                                Padding="12,10" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
